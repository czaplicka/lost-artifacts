<div id="character-creation-root">
  <form
    class="character-creation-shell"
    id="character-creation-form"
    novalidate
  >
    <header class="character-creation-header">
      <div class="character-creation-brand">
        <h1>MARK AGENCY</h1>
        <p>Personnel Intake Form — Temporary / Probably Legal</p>
      </div>

      <div class="character-creation-stamp">
        Pending<br>
        Regret
      </div>
    </header>

    <nav
      class="character-creation-steps"
      aria-label="Character creation steps"
    >
      <button
        class="character-step-marker is-active"
        type="button"
        data-step="0"
        data-step-marker
        data-step-number="1"
      >
        Identity
      </button>

      <button
        class="character-step-marker"
        type="button"
        data-step="1"
        data-step-marker
        data-step-number="2"
      >
        Profile
      </button>

      <button
        class="character-step-marker"
        type="button"
        data-step="2"
        data-step-marker
        data-step-number="3"
      >
        Instincts
      </button>

      <button
        class="character-step-marker"
        type="button"
        data-step="3"
        data-step-marker
        data-step-number="4"
      >
        Case Pressure
      </button>

      <button
        class="character-step-marker"
        type="button"
        data-step="4"
        data-step-marker
        data-step-number="5"
      >
        Dossier
      </button>
    </nav>

    <main class="character-creation-content">
      <p
        class="character-form-error"
        data-character-error
        role="alert"
      ></p>

      <!-- STEP 1: IDENTITY + APPEARANCE -->

      <section
        class="character-step-panel is-active"
        data-step-panel="0"
      >
        <h2 class="character-section-title">IDENTIFY YOURSELF</h2>

        <p class="character-section-intro">
          For administrative purposes, legal ambiguity, and an ID badge
          nobody will respect.
        </p>

        <div class="character-identity-layout">
          <div class="character-identity-fields">
            <div class="character-field">
              <label for="character-name">Name</label>

              <input
                id="character-name"
                name="name"
                type="text"
                maxlength="28"
                autocomplete="nickname"
                placeholder="e.g. Alex Mercer"
                data-character-name
              >
            </div>

            <div class="character-field">
              <label for="character-alias">Alias</label>

              <input
                id="character-alias"
                name="alias"
                type="text"
                maxlength="28"
                autocomplete="off"
                placeholder="e.g. The Last Honest Invoice"
                data-character-alias
              >
            </div>

            <button
              class="character-button character-button--randomize"
              type="button"
              data-action="randomize"
            >
              Randomize My Poor Life Choices
            </button>

            <section class="character-appearance-section">
              <h3 class="character-appearance-title">
                APPEAR PROFESSIONALLY SUSPICIOUS
              </h3>

              <p class="character-appearance-intro">
                Management requires a recognisable face.
                Management has not explained why.
              </p>

              <div class="character-appearance-controls">
                <fieldset class="appearance-option-group">
                  <legend>Skin Tone</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="skinTone"
                      data-appearance-value="light"
                    >
                      Light
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="skinTone"
                      data-appearance-value="warm"
                    >
                      Warm
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="skinTone"
                      data-appearance-value="golden"
                    >
                      Golden
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="skinTone"
                      data-appearance-value="deep"
                    >
                      Deep
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="skinTone"
                      data-appearance-value="rich"
                    >
                      Rich
                    </button>
                  </div>
                </fieldset>

                <fieldset class="appearance-option-group">
                  <legend>Hair Style</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="neat"
                    >
                      Neat
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="messy"
                    >
                      Messy
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="bob"
                    >
                      Bob
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="long"
                    >
                      Long
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="curly"
                    >
                      Curly
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="braids"
                    >
                      Braids
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="pixie"
                    >
                      Pixie
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="shaved"
                    >
                      Shaved
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairStyle"
                      data-appearance-value="hat"
                    >
                      Hat
                    </button>
                  </div>
                </fieldset>

                <fieldset class="appearance-option-group">
                  <legend>Hair Colour</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairColor"
                      data-appearance-value="black"
                    >
                      Black
                    </button>

                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="hairColor"
                      data-appearance-value="brown"
                    >
                      Brown
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairColor"
                      data-appearance-value="blonde"
                    >
                      Blonde
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairColor"
                      data-appearance-value="red"
                    >
                      Red
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="hairColor"
                      data-appearance-value="grey"
                    >
                      Grey
                    </button>
                  </div>
                </fieldset>

                <fieldset class="appearance-option-group">
                  <legend>Coat</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="coat"
                      data-appearance-value="trench"
                    >
                      Trench
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="coat"
                      data-appearance-value="leather"
                    >
                      Leather
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="coat"
                      data-appearance-value="blazer"
                    >
                      Blazer
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="coat"
                      data-appearance-value="sweater"
                    >
                      Sweater
                    </button>
                  </div>
                </fieldset>

                <fieldset class="appearance-option-group">
                  <legend>Facial Hair</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="facialHair"
                      data-appearance-value="none"
                    >
                      None
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="facialHair"
                      data-appearance-value="moustache"
                    >
                      Moustache
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="facialHair"
                      data-appearance-value="shortBeard"
                    >
                      Short Beard
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="facialHair"
                      data-appearance-value="fullBeard"
                    >
                      Full Beard
                    </button>
                  </div>
                </fieldset>

                <fieldset class="appearance-option-group">
                  <legend>Makeup</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="makeup"
                      data-appearance-value="none"
                    >
                      None
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="makeup"
                      data-appearance-value="natural"
                    >
                      Natural
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="makeup"
                      data-appearance-value="red"
                    >
                      Red Lip
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="makeup"
                      data-appearance-value="dark"
                    >
                      Dark Lip
                    </button>
                  </div>
                </fieldset>

                <fieldset class="appearance-option-group">
                  <legend>Accessory</legend>

                  <div class="appearance-option-list">
                    <button
                      class="appearance-option is-selected"
                      type="button"
                      data-appearance-category="accessory"
                      data-appearance-value="none"
                    >
                      None
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="accessory"
                      data-appearance-value="glasses"
                    >
                      Glasses
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="accessory"
                      data-appearance-value="scarf"
                    >
                      Scarf
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="accessory"
                      data-appearance-value="notebook"
                    >
                      Notebook
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="accessory"
                      data-appearance-value="studs"
                    >
                      Studs
                    </button>

                    <button
                      class="appearance-option"
                      type="button"
                      data-appearance-category="accessory"
                      data-appearance-value="hoops"
                    >
                      Hoops
                    </button>
                  </div>
                </fieldset>
              </div>
            </section>
          </div>

          <aside class="agency-id-card">
            <div class="agency-id-card-header">
              <span>Mark Agency</span>
              <span>Field Operative</span>
            </div>

            <div
              class="agency-id-avatar"
              data-avatar-preview
              data-skin-tone="light"
              data-hair-style="neat"
              data-hair-color="brown"
              data-coat="trench"
              data-facial-hair="none"
              data-makeup="none"
              data-accessory="none"
              role="img"
              aria-label="Detective portrait preview"
            >
              <div class="avatar-coat"></div>
              <div class="avatar-neck"></div>
              <div class="avatar-face"></div>
              <div class="avatar-ear avatar-ear--left"></div>
              <div class="avatar-ear avatar-ear--right"></div>
              <div class="avatar-hair"></div>
              <div class="avatar-eyes"></div>
              <div class="avatar-nose"></div>
              <div class="avatar-mouth"></div>
              <div class="avatar-facial-hair"></div>
              <div class="avatar-makeup"></div>
              <div class="avatar-accessory"></div>
            </div>

            <div
              class="agency-id-name"
              data-avatar-name
            >
              UNNAMED APPLICANT
            </div>

            <div
              class="agency-id-alias"
              data-avatar-alias
            >
              ALIAS: UNLISTED
            </div>

            <div class="agency-id-status">
              STATUS: QUESTIONABLE
            </div>
          </aside>
        </div>
      </section>

      <!-- STEP 2: PROFILE -->

      <section
        class="character-step-panel"
        data-step-panel="1"
      >
        <h2 class="character-section-title">HOW DO YOU WORK?</h2>

        <p class="character-section-intro">
          Pick a professional tendency. HR calls it a profile.
          Your old clients may disagree.
        </p>

        <div
          class="character-profile-grid"
          role="radiogroup"
          aria-label="Detective profile"
        >
          <button
            class="character-profile-card is-selected"
            type="button"
            role="radio"
            aria-checked="true"
            data-profile="analyst"
          >
            <span class="character-profile-icon">⌕</span>
            <span class="character-profile-name">The Analyst</span>
            <span class="character-profile-bonus">Deduction +1</span>
            <span class="character-profile-description">
              You notice patterns, contradictions, and coffee stains shaped
              like motives.
            </span>
          </button>

          <button
            class="character-profile-card"
            type="button"
            role="radio"
            aria-checked="false"
            data-profile="charmer"
          >
            <span class="character-profile-icon">♥</span>
            <span class="character-profile-name">The Charmer</span>
            <span class="character-profile-bonus">Rapport +1</span>
            <span class="character-profile-description">
              People keep telling you secrets. Often by accident.
              Sometimes while crying.
            </span>
          </button>

          <button
            class="character-profile-card"
            type="button"
            role="radio"
            aria-checked="false"
            data-profile="streetwise"
          >
            <span class="character-profile-icon">◆</span>
            <span class="character-profile-name">The Streetwise</span>
            <span class="character-profile-bonus">
              Resourcefulness +1
            </span>
            <span class="character-profile-description">
              You know which alley to avoid and which bartender to bribe.
            </span>
          </button>

          <button
            class="character-profile-card"
            type="button"
            role="radio"
            aria-checked="false"
            data-profile="archivist"
          >
            <span class="character-profile-icon">▤</span>
            <span class="character-profile-name">The Archivist</span>
            <span class="character-profile-bonus">Observation +1</span>
            <span class="character-profile-description">
              If it was catalogued, cursed, forged, or misfiled,
              you probably read about it.
            </span>
          </button>

          <button
            class="character-profile-card"
            type="button"
            role="radio"
            aria-checked="false"
            data-profile="improviser"
          >
            <span class="character-profile-icon">!</span>
            <span class="character-profile-name">The Improviser</span>
            <span class="character-profile-bonus">
              One free retry per case
            </span>
            <span class="character-profile-description">
              Planning is nice. Surviving the consequences is nicer.
            </span>
          </button>
        </div>
      </section>

      <!-- STEP 3: INSTINCTS -->

      <section
        class="character-step-panel"
        data-step-panel="2"
      >
        <div class="character-points-counter">
          <span
            class="character-points-value"
            data-remaining-points
          >
            2
          </span>

          <span class="character-points-label">Points Left</span>
        </div>

        <h2 class="character-section-title">
          PROFESSIONAL INSTINCTS
        </h2>

        <p class="character-section-intro">
          Assign 2 points. This shapes your approach,
          not your worth as a human being.
        </p>

        <div class="character-stat-list">
          <article class="character-stat-row">
            <div>
              <div class="character-stat-title">Observation</div>
              <div class="character-stat-description">
                Spot hidden details and suspiciously placed objects.
              </div>
            </div>

            <div class="character-stat-controls">
              <button
                class="character-stat-button"
                type="button"
                aria-label="Decrease Observation"
                data-stat-action="decrease"
                data-stat="observation"
              >
                −
              </button>

              <output
                class="character-stat-value"
                data-stat-value="observation"
              >
                1
              </output>

              <button
                class="character-stat-button"
                type="button"
                aria-label="Increase Observation"
                data-stat-action="increase"
                data-stat="observation"
              >
                +
              </button>
            </div>
          </article>

          <article class="character-stat-row">
            <div>
              <div class="character-stat-title">Deduction</div>
              <div class="character-stat-description">
                Connect evidence before it starts connecting itself.
              </div>
            </div>

            <div class="character-stat-controls">
              <button
                class="character-stat-button"
                type="button"
                aria-label="Decrease Deduction"
                data-stat-action="decrease"
                data-stat="deduction"
              >
                −
              </button>

              <output
                class="character-stat-value"
                data-stat-value="deduction"
              >
                1
              </output>

              <button
                class="character-stat-button"
                type="button"
                aria-label="Increase Deduction"
                data-stat-action="increase"
                data-stat="deduction"
              >
                +
              </button>
            </div>
          </article>

          <article class="character-stat-row">
            <div>
              <div class="character-stat-title">Rapport</div>
              <div class="character-stat-description">
                Make people talk. Preferably truthfully.
              </div>
            </div>

            <div class="character-stat-controls">
              <button
                class="character-stat-button"
                type="button"
                aria-label="Decrease Rapport"
                data-stat-action="decrease"
                data-stat="rapport"
              >
                −
              </button>

              <output
                class="character-stat-value"
                data-stat-value="rapport"
              >
                1
              </output>

              <button
                class="character-stat-button"
                type="button"
                aria-label="Increase Rapport"
                data-stat-action="increase"
                data-stat="rapport"
              >
                +
              </button>
            </div>
          </article>

          <article class="character-stat-row">
            <div>
              <div class="character-stat-title">Resourcefulness</div>
              <div class="character-stat-description">
                Find shortcuts, favours, and morally flexible solutions.
              </div>
            </div>

            <div class="character-stat-controls">
              <button
                class="character-stat-button"
                type="button"
                aria-label="Decrease Resourcefulness"
                data-stat-action="decrease"
                data-stat="resourcefulness"
              >
                −
              </button>

              <output
                class="character-stat-value"
                data-stat-value="resourcefulness"
              >
                1
              </output>

              <button
                class="character-stat-button"
                type="button"
                aria-label="Increase Resourcefulness"
                data-stat-action="increase"
                data-stat="resourcefulness"
              >
                +
              </button>
            </div>
          </article>
        </div>
      </section>

      <!-- STEP 4: DIFFICULTY -->

      <section
        class="character-step-panel"
        data-step-panel="3"
      >
        <h2 class="character-section-title">CASE PRESSURE</h2>

        <p class="character-section-intro">
          How much chaos would you like professionally documented?
        </p>

        <div
          class="character-difficulty-list"
          role="radiogroup"
          aria-label="Case difficulty"
        >
          <button
            class="character-difficulty-card"
            type="button"
            role="radio"
            aria-checked="false"
            data-difficulty="rookie"
          >
            <span class="character-difficulty-number">1</span>
            <span class="character-difficulty-name">Routine Case</span>
            <span class="character-difficulty-subtitle">
              For detectives with standards and a healthy respect for hints.
            </span>
            <span class="character-difficulty-details">
              More hints · Softer penalties · Relaxed time pressure
            </span>
          </button>

          <button
            class="character-difficulty-card is-selected"
            type="button"
            role="radio"
            aria-checked="true"
            data-difficulty="field"
          >
            <span class="character-difficulty-number">2</span>
            <span class="character-difficulty-name">Complicated Mess</span>
            <span class="character-difficulty-subtitle">
              The recommended amount of professional discomfort.
            </span>
            <span class="character-difficulty-details">
              Standard hints · Standard penalties · Standard time pressure
            </span>
          </button>

          <button
            class="character-difficulty-card"
            type="button"
            role="radio"
            aria-checked="false"
            data-difficulty="master"
          >
            <span class="character-difficulty-number">3</span>
            <span class="character-difficulty-name">
              Career-Limiting Decision
            </span>
            <span class="character-difficulty-subtitle">
              For people who consider consequences a personal insult.
            </span>
            <span class="character-difficulty-details">
              Few hints · Tough penalties · Strict time pressure
            </span>
          </button>
        </div>
      </section>

      <!-- STEP 5: DOSSIER -->

      <section
        class="character-step-panel"
        data-step-panel="4"
      >
        <h2 class="character-section-title">
          PRELIMINARY DOSSIER
        </h2>

        <p class="character-section-intro">
          Please inspect carefully. Mark Agency accepts no responsibility
          for spelling, fate, or consequences.
        </p>

        <article class="character-dossier">
          <div class="character-dossier-label">
            Field Operative
          </div>

          <div
            class="character-dossier-name"
            data-dossier-name
          >
            UNNAMED APPLICANT
          </div>

          <div class="character-dossier-row">
            <div class="character-dossier-label">Alias</div>

            <div
              class="character-dossier-value"
              data-dossier-alias
            >
              UNLISTED — SUSPICIOUSLY MODEST
            </div>
          </div>

          <div class="character-dossier-row">
            <div class="character-dossier-label">Profile</div>

            <div
              class="character-dossier-value"
              data-dossier-profile
            >
              THE ANALYST
            </div>
          </div>

          <div class="character-dossier-row">
            <div class="character-dossier-label">Profile Bonus</div>

            <div
              class="character-dossier-value"
              data-dossier-profile-bonus
            >
              Deduction +1
            </div>
          </div>

          <div class="character-dossier-row">
            <div class="character-dossier-label">Appearance</div>

            <div
              class="character-dossier-value"
              data-dossier-appearance
            >
              Light skin · Neat brown hair · Trench coat · No accessory
            </div>
          </div>

          <div class="character-dossier-row">
            <div class="character-dossier-label">Case Pressure</div>

            <div
              class="character-dossier-value"
              data-dossier-difficulty
            >
              COMPLICATED MESS
            </div>
          </div>

          <div class="character-dossier-row">
            <div class="character-dossier-label">Instincts</div>

            <div class="character-dossier-stats">
              <span
                class="character-dossier-stat"
                data-dossier-stat="observation"
              >
                OBSERVATION 1
              </span>

              <span
                class="character-dossier-stat"
                data-dossier-stat="deduction"
              >
                DEDUCTION 2
              </span>

              <span
                class="character-dossier-stat"
                data-dossier-stat="rapport"
              >
                RAPPORT 1
              </span>

              <span
                class="character-dossier-stat"
                data-dossier-stat="resourcefulness"
              >
                RESOURCEFULNESS 1
              </span>
            </div>
          </div>
        </article>
      </section>
    </main>

    <footer class="character-creation-footer">
      <button
        class="character-button"
        type="button"
        data-action="back"
        data-back-button
      >
        ← Back
      </button>

      <p
        class="character-footer-hint"
        data-footer-hint
      >
        No pressure. Your identity will only follow you around all game.
      </p>

      <div class="character-footer-actions">
        <button
          class="character-button character-button--primary"
          type="button"
          data-action="next"
          data-next-button
        >
          Continue →
        </button>
      </div>
    </footer>
  </form>
</div>