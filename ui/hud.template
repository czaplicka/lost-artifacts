<div id="hud-container">
  <button
    id="btn-hud-expand"
    class="hud-expand-btn"
    type="button"
    title="Open HUD"
    aria-label="Open HUD"
  >
    <span class="hud-expand-detective" aria-hidden="true">🕵️‍♂️</span>
  </button>

  <div class="hud-content">
    <!-- Row 1: clock, date, deadline, energy -->
    <div class="hud-paper-bg">
      <div class="hud-cell" id="clock-target" tabindex="0">
        <div class="digital-clock-display">
          <span class="clock-digital" id="clock-time">08:00</span>
          <span class="clock-period" id="clock-part">MORNING</span>
        </div>
      </div>

      <div class="hud-cell" id="date-target" tabindex="0">
        <div class="calendar-card">
          <div class="calendar-rings">
            <span></span>
            <span></span>
          </div>

          <div class="date-header" id="date-month">APR</div>
          <div class="date-body" id="date-day">01</div>
        </div>
      </div>

      <div
        class="hud-cell"
        id="deadline-target"
        data-urgency="ok"
        tabindex="0"
      >
        <div class="hourglass-wrapper">
          <svg
            class="hourglass-icon"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M6 2h12v6l-4 4 4 4v6H6v-6l4-4-4-4V2zm10 14.5l-3.5-3.5 3.5-3.5V4H8v3.5L11.5 11 8 14.5V20h8v-3.5z"/>
          </svg>

          <div class="deadline-info">
            <span class="deadline-value" id="deadline-value">4D</span>

            <div class="deadline-progress-bg">
              <div
                class="deadline-progress-fill"
                id="deadline-progress"
              ></div>
            </div>
          </div>
        </div>
      </div>

      <div class="hud-cell" id="energy-target">
        <div class="energy-wrapper">
          <svg
            class="energy-circle"
            viewBox="0 0 100 100"
            aria-hidden="true"
          >
            <circle
              class="energy-bg"
              cx="50"
              cy="50"
              r="40"
            ></circle>

            <circle
              class="energy-fill"
              id="energy-fill"
              cx="50"
              cy="50"
              r="40"
              stroke="#4caf50"
              stroke-width="8"
              stroke-dasharray="251.327"
              stroke-dashoffset="0"
              fill="none"
            ></circle>
          </svg>

          <svg
            class="energy-bolt-svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              id="energy-bolt"
              class="energy-bolt-path"
              fill="#4caf50"
              d="M11 21l-1-7H5l7-12v7h5l-6 12z"
            ></path>
          </svg>
        </div>
      </div>
    </div>

    <!-- Row 2: score, XP, cash, buttons -->
    <div class="hud-bottom-bar">
      <div class="stat-group">
        <div class="stat-item" id="score-target" tabindex="0">
          <svg
            class="stat-icon icon-score"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 2l3.1 6.6 7.2.9-5.3 4.9 1.4 7.1L12 17.9 5.6 21.5 7 14.4 1.7 9.5l7.2-.9z"/>
          </svg>

          <span class="stat-text">
            <span class="label">SCORE</span>
            <span class="value score" id="hud-score">0</span>
          </span>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item" id="xp-target" tabindex="0">
          <svg
            class="stat-icon icon-xp"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M3 21v-7h4v7H3zm7 0V9h4v12h-4zm7 0V3h4v18h-4z"/>
          </svg>

          <span class="stat-text">
            <span class="label">XP</span>
            <span class="value xp" id="hud-xp">0</span>
          </span>
        </div>

        <div class="stat-divider"></div>

        <div class="stat-item" id="cash-target" tabindex="0">
          <svg
            class="stat-icon icon-cash"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="10"/>

            <circle
              class="coin-rim"
              cx="12"
              cy="12"
              r="7.2"
            />

            <path
              class="coin-mark"
              d="M12.9 6.5v1.3c1.5.3 2.5 1.2 2.6 2.6h-1.9c-.1-.7-.7-1.1-1.6-1.1-.9 0-1.5.4-1.5 1 0 .6.5.9 1.9 1.2 2 .4 3.2 1 3.2 2.7 0 1.3-1 2.2-2.7 2.5v1.3h-1.5v-1.3c-1.7-.3-2.8-1.2-2.9-2.8h1.9c.1.8.8 1.3 1.8 1.3 1 0 1.6-.4 1.6-1 0-.7-.6-.9-2-1.2-1.9-.4-3-1-3-2.6 0-1.2.9-2.1 2.4-2.4V6.5h1.7z"
            />
          </svg>

          <span class="stat-text">
            <span class="label">CASH</span>
            <span class="value cash" id="hud-cash">$250</span>
          </span>
        </div>
      </div>

      <div class="hud-buttons">
        <img
          src="assets/ico/player.webp"
          id="btn-profile"
          class="hud-icon-btn"
          alt="Agent"
          title="AGENT DOSSIER"
        />

        <img
          src="assets/ico/profile.webp"
          id="btn-player"
          class="hud-icon-btn"
          alt="Profile"
          title="DETECTIVE PROFILE"
        />

        <button
          id="btn-expansion-store"
          class="hud-icon-btn"
          type="button"
          title="EXTRA CASES — ADDITIONAL CONTENT"
          aria-label="Open additional content store"
          onclick="event.preventDefault();event.stopPropagation();if(!this.disabled){this.disabled=true;import('./scenes/ExpansionStoreScene.js').then(module=>module.openExpansionStore()).catch(error=>{console.error('[Extra Cases] Could not open store:',error);window.alert('The additional content catalog could not be opened.');}).finally(()=>{this.disabled=false;});}"
        >
          <img
            src="assets/ico/shopping.webp"
            alt=""
            aria-hidden="true"
            draggable="false"
            width="26"
            height="26"
            style="display:block;width:26px;height:26px;object-fit:contain;pointer-events:none;filter:drop-shadow(1px 2px 1px #201910);"
          />
        </button>

        <img
          src="assets/ico/cog.webp"
          id="btn-settings"
          class="hud-icon-btn"
          alt="Settings"
          title="SETTINGS"
        />

        <button
          id="btn-hud-collapse"
          class="hud-collapse-btn"
          type="button"
          title="Collapse HUD"
          aria-label="Collapse HUD"
        >━</button>
      </div>
    </div>
  </div>

  <div class="hud-tooltip" id="hud-tooltip" role="tooltip">
    <div
      class="hud-tooltip-title"
      id="hud-tooltip-title"
    ></div>

    <div id="hud-tooltip-text"></div>
  </div>

  <div class="hud-energy-log" id="hud-energy-log">
    <div id="hud-energy-log-text"></div>
  </div>

  <!--
    UIScene.updateEnergy() sets aria-valuenow on #energy-target
    and the --hud-energy-* CSS variables on #hud-container.
  -->
</div>