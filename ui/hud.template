<div id="hud-container">
  <button id="btn-hud-expand" class="hud-expand-btn" type="button" title="Open HUD" aria-label="Open HUD">
    <span class="hud-expand-detective" aria-hidden="true">🕵️‍♂️</span>
  </button>
  <div class="hud-content">
    <div class="hud-paper-bg">
      <div class="hud-cell" id="clock-target">
        <div class="digital-clock-display">
          <span class="clock-digital" id="clock-time">08:00</span>
          <span class="clock-period" id="clock-part">MORNING</span>
        </div>
      </div>
      <div class="hud-cell" id="date-target">
        <div class="calendar-card">
          <div class="calendar-rings"><span></span><span></span></div>
          <div class="date-header" id="date-month">APR</div>
          <div class="date-body" id="date-day">01</div>
        </div>
      </div>
      <div class="hud-cell" id="deadline-target">
        <div class="hourglass-wrapper">
          <svg class="hourglass-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2h12v6l-4 4 4 4v6H6v-6l4-4-4-4V2zm10 14.5l-3.5-3.5 3.5-3.5V4H8v3.5L11.5 11 8 14.5V20h8v-3.5z"/></svg>
          <div class="deadline-info">
            <span class="deadline-value" id="deadline-value">4D</span>
            <div class="deadline-progress-bg"><div class="deadline-progress-fill" id="deadline-progress"></div></div>
          </div>
        </div>
      </div>
      <div class="hud-cell" id="energy-target">
        <div class="energy-wrapper">
          <svg class="energy-circle" viewBox="0 0 100 100" aria-hidden="true">
            <circle class="energy-bg" cx="50" cy="50" r="40"></circle>
            <circle class="energy-fill" id="energy-fill" cx="50" cy="50" r="40" stroke="#4caf50" stroke-width="8" stroke-dasharray="251.327" stroke-dashoffset="0" fill="none"></circle>
          </svg>
          <svg class="energy-bolt-svg" viewBox="0 0 24 24" aria-hidden="true"><path id="energy-bolt" class="energy-bolt-path" fill="#4caf50" d="M11 21l-1-7H5l7-12v7h5l-6 12z"></path></svg>
        </div>
      </div>
    </div>
    <div class="hud-bottom-bar">
      <div class="stat-group">
        <div class="stat-item" id="score-target">
          <span class="stat-icon" aria-hidden="true">⭐</span>
          <span class="label">SCORE</span>
          <span class="value score" id="hud-score">0</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item" id="xp-target">
          <span class="stat-icon" aria-hidden="true">📈</span>
          <span class="label">XP</span>
          <span class="value xp" id="hud-xp">0</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item" id="cash-target">
          <span class="stat-icon" aria-hidden="true">💵</span>
          <span class="label">CASH</span>
          <span class="value cash" id="hud-cash">$250</span>
        </div>
      </div>
      <div class="hud-buttons">
        <img src="assets/ico/player.webp" id="btn-profile" class="hud-icon-btn" alt="Agent" title="AGENT DOSSIER"/>
        <img src="assets/ico/profile.webp" id="btn-player" class="hud-icon-btn" alt="Profile" title="DETECTIVE PROFILE"/>
        <button id="btn-expansion-store" class="hud-icon-btn" type="button" title="EXTRA CASES — ADDITIONAL CONTENT" aria-label="Open additional content store"
          onclick="event.preventDefault();event.stopPropagation();if(!this.disabled){this.disabled=true;import('./scenes/ExpansionStoreScene.js').then(module=>module.openExpansionStore()).catch(error=>{console.error('[Extra Cases] Could not open store:',error);window.alert('The additional content catalog could not be opened.');}).finally(()=>{this.disabled=false;});}">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" aria-hidden="true" style="display:block;filter:drop-shadow(1px 2px 1px #201910);">
            <path d="M3 10H13L16 13H29V27H3V10Z" fill="#b99257" stroke="#49351f" stroke-width="2"/>
            <path d="M3 10V6H13L16 10H27V13" fill="#dfc28a" stroke="#49351f" stroke-width="2"/>
            <path d="M11 20H21M16 15V25" stroke="#fff0c9" stroke-width="3"/>
          </svg>
        </button>
        <img src="assets/ico/cog.webp" id="btn-settings" class="hud-icon-btn" alt="Settings" title="SETTINGS"/>
        <button id="btn-hud-collapse" class="hud-collapse-btn" type="button" title="Collapse HUD" aria-label="Collapse HUD">━</button>
      </div>
    </div>
  </div>
  <div class="hud-tooltip" id="hud-tooltip"><div class="hud-tooltip-title" id="hud-tooltip-title"></div><div id="hud-tooltip-text"></div></div>
  <div class="hud-energy-log" id="hud-energy-log"><div id="hud-energy-log-text"></div></div>
  <!-- The existing UIScene.updateEnergy() updates aria-valuenow on #energy-target. -->
  <style>
    /* ═══ HUD Custom Variables ═══ */
    #hud-container {
      --hud-energy-level: 0%;
      --hud-energy-color: #69706a;
      --hud-energy-label: '--';
    }

    /* ═══ Collapsed expand button — energy fill + label ═══ */
    #hud-container #btn-hud-expand {
      box-sizing: border-box;
      overflow: hidden;
      isolation: isolate;
      border-color: var(--hud-energy-color) !important;
      background: linear-gradient(to top,
        var(--hud-energy-color) 0%,
        var(--hud-energy-color) var(--hud-energy-level),
        #24251f var(--hud-energy-level),
        #24251f 100%) !important;
      box-shadow: inset 0 0 0 2px #11170fc0, 0 3px 8px #0008;
      text-shadow: 0 2px 3px #000;
    }
    #hud-container #btn-hud-expand .hud-expand-detective {
      position: relative;
      top: -4px;
      pointer-events: none;
      filter: drop-shadow(0 1px 2px #000b);
    }
    #hud-container #btn-hud-expand::after {
      content: var(--hud-energy-label);
      position: absolute;
      bottom: 3px;
      left: 50%;
      transform: translateX(-50%);
      color: #fff7df;
      background: #111a;
      border-radius: 3px;
      padding: 1px 3px;
      font: 10px/1.15 SpecialElite, monospace;
      pointer-events: none;
      white-space: nowrap;
    }
    #hud-container #btn-hud-expand:focus-visible {
      outline: 3px solid #fff0b8;
      outline-offset: 3px;
    }

    /* ═══ XP stat styling ═══ */
    .stat-item .value.xp {
      color: #ffd166;
    }

    #xp-target {
      cursor: help;
    }

    /* ═══ Stat icons ═══ */
    .stat-icon {
      font-size: 13px;
      line-height: 1;
      flex-shrink: 0;
    }

    /* ═══ Expansion store button ═══ */
    #btn-expansion-store.hud-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0;
      background: transparent;
      border: 0;
      cursor: pointer;
      flex-shrink: 0;
    }

    /* ═══ Energy level → CSS var mapping ═══ */
